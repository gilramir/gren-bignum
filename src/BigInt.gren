module BigInt exposing
    ( BigInt
    , Error(..)
    , abs
    , add
    , and
    , bitLength
    , compare
    , complement
    , divBy
    , divModBy
    , fitsSigned
    , fitsUnsigned
    , fromFloat
    , fromInt
    , fromString
    , fromStringWithBase
    , fromStringWithBaseWithin
    , fromStringWithin
    , isEven
    , isNegative
    , isOdd
    , isZero
    , maskTo
    , max
    , min
    , modBy
    , mul
    , negate
    , one
    , or
    , popCount
    , powBy
    , quotBy
    , quotRemBy
    , remainderBy
    , shiftLeftBy
    , shiftRightBy
    , subBy
    , toFloat
    , toInt
    , toSigned
    , toString
    , toStringWithBase
    , xor
    , zero
    )

{-| Integers of any size, and the fixed-width views of them if you need them.

A Gren `Int` is a double, so it is exact up to 2^53 and wrong above that. That
is fine until you are working out what a `uint64` did, and then it is the
whole problem: `0xFFFFFFFFFFFFFFFF` is not representable, and what comes back
instead is `18446744073709552000`, with nothing to say so.

A `BigInt` has no width. Instead, it has a way to ask for one:

    -- what does this look like as a uint64?
    BigInt.maskTo 64 x

    -- ...and as an int64?
    BigInt.toSigned 64 x

    -- would it have overflowed?
    BigInt.fitsSigned 64 x

The width is a question you put to a value, not a property the value carries
around and can silently violate.

@docs BigInt


## Making them

@docs zero, one, fromInt, toInt, fromFloat, toFloat


## Reading and writing

@docs fromString, toString, fromStringWithBase, toStringWithBase


## Reading text you did not write

@docs fromStringWithin, fromStringWithBaseWithin, Error


## Arithmetic

@docs add, subBy, mul, negate, abs, powBy


## Dividing

There are two, because C and Python define division differently and you are
usually checking one of them. Each comes in three forms: the pair, and either
half on its own.

@docs quotRemBy, quotBy, remainderBy
@docs divModBy, divBy, modBy


## Comparing

@docs compare, isZero, isNegative, isEven, isOdd, max, min


## Bits

@docs and, or, xor, complement, shiftLeftBy, shiftRightBy, bitLength, popCount


## Widths

@docs maskTo, toSigned, fitsSigned, fitsUnsigned


## A note on argument order

Wherever the order of the operands matters, the subject comes **last**. This
matches `Math.modBy`, `Math.remainderBy` and `Bitwise.shiftLeftBy` in core:

    a |> BigInt.subBy one -- a - 1

    a |> BigInt.quotRemBy (BigInt.fromInt 2) -- a / 2

    a |> BigInt.shiftLeftBy 8 -- a << 8

`compare` is the exception. It stands in for `Basics.compare`, so it takes its
arguments in the same order that one does.

-}

import Array exposing (Array)
import Array.Builder as Builder
import Bitwise
import Char
import Math
import Maybe exposing (Maybe(..))
import String


-- THE TYPE


{-| An integer of any size.

The representation is sign and magnitude rather than two's complement: a
`Bool` for the sign, and an array of 24-bit limbs for the magnitude, least
significant first, with no leading zero limbs. Zero is the empty array, and is
never negative.

Limbs smaller than the range a double holds exactly is the standard way to
build this. CPython uses 30-bit digits and bn.js uses 26, and the reason is
multiplication: a limb times a limb plus a carry has to stay under 2^53. What
is particular here is the 24. It gives up two of bn.js's bits for a different
property: 24 is divisible by 1, 2, 3 and 4, so binary, octal and hexadecimal
all land on limb boundaries. One limb is exactly six hex digits, eight octal
digits, or twenty-four binary digits, so
[`toStringWithBase`](#toStringWithBase) writes those bases by slicing the
limbs apart rather than by dividing the number down (see `sliceLimbs`). Every
other base, base 32 included, has to divide. The README says where all of this
comes from; the algorithms are Knuth's.

Two's complement does appear, in [`and`](#and) and its neighbors, which read
a value *as if* it were two's complement of unbounded width. That is the only
reading under which `complement 5` can be `-6` when nobody has said how wide
the number is.

-}
type BigInt
    = BigInt
        { negative : Bool
        , limbs : Array Int
        }


limbBits : Int
limbBits =
    24


limbBase : Int
limbBase =
    0x1000000


limbBaseFloat : Float
limbBaseFloat =
    16777216


-- CONSTRUCTION


{-| Zero.

This is the value the whole representation is normalized around: a magnitude
that cancels becomes the empty limb array, and an empty limb array is never
negative. So there is exactly one zero, and `x |> subBy x == BigInt.zero` is
a reliable test.

It is also the divisor that makes every division in this module return
`Nothing`.

-}
zero : BigInt
zero =
    BigInt { negative = False, limbs = [] }


{-| One.

Mostly the step: `x |> add one` and `x |> subBy one`. It is also the empty
product, so `powBy 0` returns it for any base.

-}
one : BigInt
one =
    BigInt { negative = False, limbs = [ 1 ] }


{-| Build a value from a sign and a magnitude, normalizing both: leading zero
limbs go, and a zero magnitude is never negative. Every value in this module is
made here, which is what makes `==` mean numeric equality.
-}
make : Bool -> Array Int -> BigInt
make negative limbs =
    let
        trimmed =
            normalize limbs
    in
    if Array.isEmpty trimmed then
        zero

    else
        BigInt { negative = negative, limbs = trimmed }


unwrap : BigInt -> Array Int
unwrap (BigInt value) =
    value.limbs


{-| An ordinary `Int`. Above 2^53 an `Int` is already inexact, so this
converts the double you passed, not the number you meant.
-}
fromInt : Int -> BigInt
fromInt n =
    -- Through `fromFloat` rather than by dividing the `Int` down, because
    -- `//` cannot be trusted with a quotient this large. See the note under
    -- MAGNITUDES.
    Maybe.withDefault zero (fromFloat (Basics.toFloat n))


{-| Back to an `Int`, when it fits in one exactly, which means no larger than
`Math.maxSafeInteger`. Anything bigger is `Nothing`, not a number that is
almost right.
-}
toInt : BigInt -> Maybe Int
toInt value =
    if toFloat (abs value) > Basics.toFloat Math.maxSafeInteger then
        Nothing

    else
        Just (Math.truncate (toFloat value))


{-| Truncate a `Float` toward zero. `NaN` and the infinities are `Nothing`.
Everything else has an exact integer part, however large, because past a
certain exponent a double *is* an integer.

Toward zero rather than floored, the same split as [`quotRemBy`](#quotRemBy)
against [`divModBy`](#divModBy):

    BigInt.fromFloat -3.7 --> Just (BigInt.fromInt -3)

The result is exact, not approximate. Example:

    BigInt.fromFloat 1.0e30 |> Maybe.map BigInt.toString
    --> Just "1000000000000000019884624838656"

Those trailing digits are not noise. That is the integer the double has held
all along, and this is the function that shows you which one you actually
have. [`toFloat`](#toFloat) is the direction that loses it again.

-}
fromFloat : Float -> Maybe BigInt
fromFloat f =
    if Basics.isNaN f || Basics.isInfinite f then
        Nothing

    else
        let
            go value acc =
                if value < 1 then
                    acc

                else
                    let
                        -- Dividing by a power of two is exact at any
                        -- magnitude, so this loop never drops a bit the double
                        -- still had.
                        rest =
                            Basics.toFloat (Math.truncate (value / limbBaseFloat))
                    in
                    go rest (Array.pushLast (Math.truncate (value - rest * limbBaseFloat)) acc)
        in
        Just (make (f < 0) (go (Math.abs f) []))


{-| To a `Float`, rounding once the value no longer fits.

This is the lossy half of the round trip, and above 2^53 it is lossy quietly:

    BigInt.toFloat (BigInt.add big BigInt.one) == BigInt.toFloat big
    -- True for big = 2^64, and nothing says the one went missing

[`fromFloat`](#fromFloat) loses nothing going the other way, so a value
survives a round trip through a `String` but not through a `Float`. If you
need to store one, store the string.

-}
toFloat : BigInt -> Float
toFloat (BigInt value) =
    let
        magnitude =
            Array.foldr (\limb acc -> acc * limbBaseFloat + Basics.toFloat limb) 0 value.limbs
    in
    if value.negative then
        Basics.negate magnitude

    else
        magnitude


-- MAGNITUDES
--
-- Everything from here to the next banner works on bare limb arrays:
-- little-endian, base 2^24, normalized. None of it knows about signs.
--
-- One platform fact governs all of it. **Gren's `//` truncates its result to
-- 32 bits**: `(2^48) // 2` is 0, and `(2^31) // 1` is -2147483648. It is
-- `(a / b) | 0` underneath, so what has to fit in 32 bits is the *quotient*,
-- not the operands. Every `//` below is therefore on a quotient smaller than
-- 2^25 by construction -- a carry out of a limb, a digit of the answer, an
-- index -- and that is a property to preserve rather than a coincidence. Where
-- a quotient can be large, `Math.truncate (a / b)` is the one that is right at
-- any size.


limbAt : Int -> Array Int -> Int
limbAt index limbs =
    Maybe.withDefault 0 (Array.get index limbs)


normalize : Array Int -> Array Int
normalize limbs =
    when Array.popLast limbs is
        Just popped ->
            if popped.last == 0 then
                normalize popped.initial

            else
                limbs

        Nothing ->
            limbs


magCompare : Array Int -> Array Int -> Order
magCompare a b =
    if Array.length a /= Array.length b then
        Basics.compare (Array.length a) (Array.length b)

    else
        let
            go index =
                if index < 0 then
                    EQ

                else if limbAt index a /= limbAt index b then
                    Basics.compare (limbAt index a) (limbAt index b)

                else
                    go (index - 1)
        in
        go (Array.length a - 1)


magAdd : Array Int -> Array Int -> Array Int
magAdd a b =
    let
        len =
            Basics.max (Array.length a) (Array.length b)

        go index carry acc =
            if index >= len then
                if carry > 0 then
                    Builder.pushLast carry acc

                else
                    acc

            else
                let
                    sum =
                        limbAt index a + limbAt index b + carry

                    high =
                        sum // limbBase
                in
                go (index + 1) high (Builder.pushLast (sum - high * limbBase) acc)
    in
    normalize (Builder.toArray (go 0 0 (Builder.empty (len + 1))))


{-| `a - b`, where `a` is known to be at least `b`. Every caller checks first.
-}
magSub : Array Int -> Array Int -> Array Int
magSub a b =
    let
        len =
            Array.length a

        go index borrow acc =
            if index >= len then
                acc

            else
                let
                    diff =
                        limbAt index a - limbAt index b - borrow
                in
                if diff < 0 then
                    go (index + 1) 1 (Builder.pushLast (diff + limbBase) acc)

                else
                    go (index + 1) 0 (Builder.pushLast diff acc)
    in
    normalize (Builder.toArray (go 0 0 (Builder.empty len)))


{-| One limb times a magnitude. A limb times a limb plus a carry is under 2^48,
so every step of this is exact, which is the property the limb size was
chosen for.
-}
mulByLimb : Int -> Array Int -> Array Int
mulByLimb factor limbs =
    if factor == 0 then
        []

    else
        let
            len =
                Array.length limbs

            go index carry acc =
                if index >= len then
                    if carry > 0 then
                        Builder.pushLast carry acc

                    else
                        acc

                else
                    let
                        product =
                            limbAt index limbs * factor + carry

                        high =
                            product // limbBase
                    in
                    go (index + 1) high (Builder.pushLast (product - high * limbBase) acc)
        in
        normalize (Builder.toArray (go 0 0 (Builder.empty (len + 1))))


{-| Multiply by `limbBase ^ count`: shifting left by whole limbs.
-}
shiftLimbs : Int -> Array Int -> Array Int
shiftLimbs count limbs =
    if Array.isEmpty limbs || count <= 0 then
        limbs

    else
        Array.prepend (Array.repeat count 0) limbs


{-| Long multiplication, a row at a time. Accumulating rows with `magAdd`
instead of writing into a scratch buffer keeps this to sequential building on
immutable arrays, and costs nothing asymptotically.
-}
magMul : Array Int -> Array Int -> Array Int
magMul a b =
    if Array.isEmpty a || Array.isEmpty b then
        []

    else
        Array.indexedFoldl
            (\index limb acc ->
                if limb == 0 then
                    acc

                else
                    magAdd acc (shiftLimbs index (mulByLimb limb a))
            )
            []
            b


{-| Divide by something that fits in a single limb. The running remainder is
under a limb, so `remainder * limbBase + digit` is under 2^48 and the loop
stays exact.
-}
magDivModLimb : Int -> Array Int -> { quotient : Array Int, remainder : Int }
magDivModLimb divisor limbs =
    let
        go index remainder acc =
            if index < 0 then
                { quotient = normalize (Array.reverse (Builder.toArray acc))
                , remainder = remainder
                }

            else
                let
                    current =
                        remainder * limbBase + limbAt index limbs

                    digit =
                        current // divisor
                in
                go (index - 1) (current - digit * divisor) (Builder.pushLast digit acc)
    in
    go (Array.length limbs - 1) 0 (Builder.empty (Array.length limbs))


{-| Multiply by `2 ^ count`, for a count smaller than one limb.
-}
magShiftLeftBits : Int -> Array Int -> Array Int
magShiftLeftBits count limbs =
    if count == 0 then
        limbs

    else
        let
            multiplier =
                2 ^ count

            len =
                Array.length limbs

            go index carry acc =
                if index >= len then
                    if carry > 0 then
                        Builder.pushLast carry acc

                    else
                        acc

                else
                    let
                        value =
                            limbAt index limbs * multiplier + carry

                        high =
                            value // limbBase
                    in
                    go (index + 1) high (Builder.pushLast (value - high * limbBase) acc)
        in
        normalize (Builder.toArray (go 0 0 (Builder.empty (len + 1))))


{-| Divide by `2 ^ count`, for a count smaller than one limb, dropping whatever
falls off the bottom.
-}
magShiftRightBits : Int -> Array Int -> Array Int
magShiftRightBits count limbs =
    if count == 0 then
        limbs

    else
        let
            divisor =
                2 ^ count

            go index carry acc =
                if index < 0 then
                    normalize (Array.reverse (Builder.toArray acc))

                else
                    let
                        value =
                            carry * limbBase + limbAt index limbs

                        digit =
                            value // divisor
                    in
                    go (index - 1) (value - digit * divisor) (Builder.pushLast digit acc)
        in
        go (Array.length limbs - 1) 0 (Builder.empty (Array.length limbs))


magShiftLeft : Int -> Array Int -> Array Int
magShiftLeft count limbs =
    shiftLimbs (count // limbBits) (magShiftLeftBits (Math.modBy limbBits count) limbs)


magShiftRight : Int -> Array Int -> Array Int
magShiftRight count limbs =
    magShiftRightBits (Math.modBy limbBits count) (Array.dropFirst (count // limbBits) limbs)


{-| How many bits one limb uses.
-}
limbBitLength : Int -> Int
limbBitLength limb =
    if limb == 0 then
        0

    else
        1 + limbBitLength (limb // 2)


{-| Long division: Knuth's Algorithm D, written as a fold rather than as
mutation of a scratch buffer.

Both operands are shifted left until the divisor's top limb fills at least
half of one. That is what bounds the error in the trial quotient to two, so
the correction loop runs at most twice however unlucky the numbers are.
Without the normalization the estimate can be arbitrarily bad, and the loop
that fixes it would become the whole algorithm.

-}
magDivMod : Array Int -> Array Int -> { quotient : Array Int, remainder : Array Int }
magDivMod dividend divisor =
    if magCompare dividend divisor == LT then
        { quotient = [], remainder = dividend }

    else if Array.length divisor == 1 then
        let
            answer =
                magDivModLimb (limbAt 0 divisor) dividend
        in
        { quotient = answer.quotient
        , remainder =
            if answer.remainder == 0 then
                []

            else
                [ answer.remainder ]
        }

    else
        let
            shift =
                limbBits - limbBitLength (limbAt (Array.length divisor - 1) divisor)

            answer =
                longDivide (magShiftLeftBits shift dividend) (magShiftLeftBits shift divisor)
        in
        { quotient = answer.quotient
        , remainder = magShiftRightBits shift answer.remainder
        }


longDivide : Array Int -> Array Int -> { quotient : Array Int, remainder : Array Int }
longDivide dividend divisor =
    let
        width =
            Array.length divisor

        go index remainder acc =
            if index < 0 then
                { quotient = normalize (Array.reverse (Builder.toArray acc))
                , remainder = remainder
                }

            else
                let
                    -- The running remainder, with one more limb of the
                    -- dividend pulled down beside it.
                    current =
                        magAdd (shiftLimbs 1 remainder) [ limbAt index dividend ]

                    estimate =
                        Basics.min
                            (limbBase - 1)
                            ((limbAt width current * limbBase + limbAt (width - 1) current)
                                // limbAt (width - 1) divisor
                            )

                    digit =
                        correct estimate current divisor
                in
                go (index - 1)
                    (magSub current (mulByLimb digit divisor))
                    (Builder.pushLast digit acc)
    in
    go (Array.length dividend - 1) [] (Builder.empty (Array.length dividend))


{-| Walk the trial quotient down until it fits. Normalization caps this at two
turns. It is a loop rather than two subtractions because if that bound were
ever wrong, two subtractions would fail silently.
-}
correct : Int -> Array Int -> Array Int -> Int
correct digit current divisor =
    if digit <= 0 then
        0

    else if magCompare (mulByLimb digit divisor) current == GT then
        correct (digit - 1) current divisor

    else
        digit


-- ARITHMETIC


{-| Add. There is no overflow to think about.

No `By` suffix, unlike [`subBy`](#subBy), because addition is commutative, so
there is no subject for a pipeline to put last.

Sign and magnitude means this is only sometimes an addition: when the signs
differ it is the smaller magnitude subtracted from the larger, and the answer
takes the sign of whichever was larger.

-}
add : BigInt -> BigInt -> BigInt
add (BigInt a) (BigInt b) =
    if a.negative == b.negative then
        make a.negative (magAdd a.limbs b.limbs)

    else
        when magCompare a.limbs b.limbs is
            LT ->
                make b.negative (magSub b.limbs a.limbs)

            _ ->
                make a.negative (magSub a.limbs b.limbs)


{-| Subtract the first from the second: `subBy b a` is `a - b`.

    a |> BigInt.subBy one

-}
subBy : BigInt -> BigInt -> BigInt
subBy b a =
    add a (negate b)


{-| Multiply, exactly, however big the answer gets. Commutative, so no `By`.

The sign is whether the two signs differed. The magnitudes go through long
multiplication, a row at a time, so the cost is the product of the two
lengths.

-}
mul : BigInt -> BigInt -> BigInt
mul (BigInt a) (BigInt b) =
    make (a.negative /= b.negative) (magMul a.limbs b.limbs)


{-| Flip the sign. The limbs are handed through untouched: no arithmetic
happens here at any size, only the sign changes.

`negate zero` is `zero`: it goes through `make`, which never produces a
negative zero, so there is only ever one.

-}
negate : BigInt -> BigInt
negate (BigInt value) =
    make (not value.negative) value.limbs


{-| Drop the sign. Again the limbs pass through untouched.

This one cannot fail. `abs` of the most negative value is the classic
fixed-width bug: there is no positive `Int.minValue` to return, so it comes
back negative. A `BigInt` has no most negative value, so the bug has nowhere
to happen.

-}
abs : BigInt -> BigInt
abs (BigInt value) =
    make False value.limbs


{-| Raise to a power: `powBy exponent base`.

A negative exponent is not an error. It gives the truncated integer answer,
the same as every other division in this module: two to the minus three is an
eighth, truncated to zero; one to any negative power is one; and zero to a
negative power, the only genuinely undefined case, is zero.

    BigInt.fromInt 2 |> BigInt.powBy 10 --> BigInt.fromInt 1024

-}
powBy : Int -> BigInt -> BigInt
powBy exponent base =
    if exponent < 0 then
        one
            |> quotBy (powBy (Basics.negate exponent) base)
            |> Maybe.withDefault zero

    else
        powLoop exponent base one


powLoop : Int -> BigInt -> BigInt -> BigInt
powLoop exponent base acc =
    if exponent == 0 then
        acc

    else if Math.modBy 2 exponent == 1 then
        powLoop (exponent - 1) base (mul acc base)

    else
        powLoop (exponent // 2) (mul base base) acc


{-| Divide, truncating toward zero, so the remainder takes the sign of the
dividend: `quotRemBy divisor dividend`. This is C's `/` and `%`, and Gren's own
`//` and `Math.remainderBy`.

`-7 / 2` is `-3` remainder `-1` here.

`Nothing` when the divisor is zero, which is the only way it can fail.

-}
quotRemBy : BigInt -> BigInt -> Maybe { quotient : BigInt, remainder : BigInt }
quotRemBy (BigInt divisor) (BigInt dividend) =
    if Array.isEmpty divisor.limbs then
        Nothing

    else
        let
            answer =
                magDivMod dividend.limbs divisor.limbs
        in
        Just
            { quotient = make (dividend.negative /= divisor.negative) answer.quotient
            , remainder = make dividend.negative answer.remainder
            }


{-| The quotient alone, truncating toward zero: `quotBy divisor dividend`.
This is Gren's `//`, except that it is still correct above 2^31.

    BigInt.fromInt -7 |> BigInt.quotBy (BigInt.fromInt 2)
    --> Just (BigInt.fromInt -3)

`Nothing` when the divisor is zero.

-}
quotBy : BigInt -> BigInt -> Maybe BigInt
quotBy divisor dividend =
    quotRemBy divisor dividend
        |> Maybe.map .quotient


{-| The remainder alone, taking the sign of the dividend:
`remainderBy divisor dividend`. This is `Math.remainderBy`.

    BigInt.fromInt -7 |> BigInt.remainderBy (BigInt.fromInt 2)
    --> Just (BigInt.fromInt -1)

`Nothing` when the divisor is zero.

-}
remainderBy : BigInt -> BigInt -> Maybe BigInt
remainderBy divisor dividend =
    quotRemBy divisor dividend
        |> Maybe.map .remainder


{-| Divide, flooring, so the modulus takes the sign of the divisor:
`divModBy divisor dividend`. This is Python's `//` and `%`, and Gren's own
`Math.modBy`.

`-7 / 2` is `-4` modulus `1` here.

The two differ only when exactly one operand is negative. Which one you want
depends on whether you are checking C or Python, so both are here.

-}
divModBy : BigInt -> BigInt -> Maybe { quotient : BigInt, modulus : BigInt }
divModBy divisor dividend =
    quotRemBy divisor dividend
        |> Maybe.map
            (\answer ->
                if isZero answer.remainder || isNegative answer.remainder == isNegative divisor then
                    { quotient = answer.quotient, modulus = answer.remainder }

                else
                    { quotient = answer.quotient |> subBy one
                    , modulus = add answer.remainder divisor
                    }
            )


{-| The floored quotient alone: `divBy divisor dividend`. Python's `//`.

    BigInt.fromInt -7 |> BigInt.divBy (BigInt.fromInt 2)
    --> Just (BigInt.fromInt -4)

`Nothing` when the divisor is zero.

-}
divBy : BigInt -> BigInt -> Maybe BigInt
divBy divisor dividend =
    divModBy divisor dividend
        |> Maybe.map .quotient


{-| The modulus alone, taking the sign of the divisor: `modBy divisor
dividend`. This is `Math.modBy`, and it is the one to reach for when the
question is divisibility, because its answer is zero or has the divisor's
sign and never the dividend's.

    BigInt.fromInt -7 |> BigInt.modBy (BigInt.fromInt 2)
    --> Just (BigInt.fromInt 1)

`Nothing` when the divisor is zero.

-}
modBy : BigInt -> BigInt -> Maybe BigInt
modBy divisor dividend =
    divModBy divisor dividend
        |> Maybe.map .modulus


-- COMPARING


{-| How the first compares to the second, the way `Basics.compare` does.
-}
compare : BigInt -> BigInt -> Order
compare (BigInt a) (BigInt b) =
    if a.negative /= b.negative then
        if a.negative then
            LT

        else
            GT

    else if a.negative then
        magCompare b.limbs a.limbs

    else
        magCompare a.limbs b.limbs


{-| Whether this is zero, which is `Array.isEmpty` on the limbs and so costs
nothing at any size.

`x == BigInt.zero` gives the same answer, because normalization guarantees a
single representation. This one just reads better.

-}
isZero : BigInt -> Bool
isZero (BigInt value) =
    Array.isEmpty value.limbs


{-| Zero is not negative.
-}
isNegative : BigInt -> Bool
isNegative (BigInt value) =
    value.negative


{-| Whether this is a multiple of two. Zero is.

This reads only the bottom bit of the bottom limb, since the limbs are
little-endian; nothing else in the number is touched. Asking through a
division instead (`modBy (fromInt 2)`) walks every limb and builds a quotient
nobody wanted.

The sign does not come into it, because the representation is sign and
magnitude and `-7` is odd for the same reason `7` is.

-}
isEven : BigInt -> Bool
isEven (BigInt value) =
    Bitwise.and 1 (limbAt 0 value.limbs) == 0


{-| Whether this is not a multiple of two.

    BigInt.isOdd (BigInt.fromInt -7) --> True

-}
isOdd : BigInt -> Bool
isOdd value =
    not (isEven value)


{-| The larger of the two, standing in for `Basics.max`.
-}
max : BigInt -> BigInt -> BigInt
max a b =
    if compare a b == LT then
        b

    else
        a


{-| The smaller of the two, standing in for `Basics.min`.
-}
min : BigInt -> BigInt -> BigInt
min a b =
    if compare a b == GT then
        b

    else
        a


-- BITS
--
-- These read a value as two's complement of unbounded width: a negative number
-- is an infinite run of one bits with its magnitude at the bottom. It is the
-- only reading under which `complement 5 == -6` without anybody having said
-- how wide the number is.


{-| The two's complement limbs of a value, in a field `width` limbs wide. A
positive number is itself; a negative one is `limbBase ^ width - |x|`, which is
the arithmetic a machine does.
-}
twosComplement : Int -> BigInt -> Array Int
twosComplement width (BigInt value) =
    let
        pattern =
            if value.negative then
                magSub (powerOfLimbBase width) value.limbs

            else
                value.limbs
    in
    Array.initialize width 0 (\index -> limbAt index pattern)


powerOfLimbBase : Int -> Array Int
powerOfLimbBase width =
    Array.pushLast 1 (Array.repeat width 0)


bitwise : (Bool -> Bool -> Bool) -> (Int -> Int -> Int) -> BigInt -> BigInt -> BigInt
bitwise signOp limbOp a b =
    let
        -- One limb wider than either operand, so the sign has somewhere to
        -- live: two negatives ANDed together are still negative, and the
        -- result has to have room to say so.
        width =
            1 + Basics.max (Array.length (unwrap a)) (Array.length (unwrap b))

        result =
            Array.map2 limbOp (twosComplement width a) (twosComplement width b)
    in
    if signOp (isNegative a) (isNegative b) then
        make True (magSub (powerOfLimbBase width) (normalize result))

    else
        make False result


{-| Bitwise AND.
-}
and : BigInt -> BigInt -> BigInt
and =
    bitwise (&&) Bitwise.and


{-| Bitwise OR.
-}
or : BigInt -> BigInt -> BigInt
or =
    bitwise (||) Bitwise.or


{-| Bitwise XOR.
-}
xor : BigInt -> BigInt -> BigInt
xor =
    bitwise Basics.xor Bitwise.xor


{-| Flip every bit, which for a number with no width is exactly `-x - 1`.

    BigInt.complement (BigInt.fromInt 5) --> BigInt.fromInt -6

-}
complement : BigInt -> BigInt
complement value =
    negate (add value one)


{-| Shift left, which is multiplication by a power of two and never loses
anything. A negative count shifts the other way.
-}
shiftLeftBy : Int -> BigInt -> BigInt
shiftLeftBy count (BigInt value) =
    if count < 0 then
        shiftRightBy (Basics.negate count) (BigInt value)

    else
        make value.negative (magShiftLeft count value.limbs)


{-| Shift right *arithmetically*: the sign is kept and the result is floored,
so `-1` shifted right stays `-1` rather than becoming `0`. That is what a
machine's arithmetic shift does and what two's complement means. The truncating
version is [`quotRemBy`](#quotRemBy) with a power of two.
-}
shiftRightBy : Int -> BigInt -> BigInt
shiftRightBy count (BigInt value) =
    if count < 0 then
        shiftLeftBy (Basics.negate count) (BigInt value)

    else
        let
            shifted =
                magShiftRight count value.limbs
        in
        if value.negative && magCompare (magShiftLeft count shifted) value.limbs /= EQ then
            -- Flooring a negative number rounds away from zero, so anything
            -- that fell off the bottom costs one.
            make True (magAdd shifted [ 1 ])

        else
            make value.negative shifted


{-| How many bits the magnitude needs; zero for zero. The sign is not counted,
because a `BigInt` has no width for a sign bit to live in.

    BigInt.fromInt 255 |> BigInt.bitLength --> 8

-}
bitLength : BigInt -> Int
bitLength (BigInt value) =
    when Array.popLast value.limbs is
        Just popped ->
            Array.length popped.initial * limbBits + limbBitLength popped.last

        Nothing ->
            0


{-| How many bits of the *magnitude* are set. Counting a negative number's bits
would mean counting an infinite run of ones, so this counts the magnitude's and
says so; [`maskTo`](#maskTo) first if that is not what you meant.
-}
popCount : BigInt -> Int
popCount (BigInt value) =
    Array.foldl (\limb acc -> acc + limbPopCount limb) 0 value.limbs


limbPopCount : Int -> Int
limbPopCount limb =
    if limb == 0 then
        0

    else
        Math.modBy 2 limb + limbPopCount (limb // 2)


-- WIDTHS


{-| The low `width` bits, as a number that is never negative, which is what
reading a value as an unsigned integer of that width means.

    BigInt.fromInt -1 |> BigInt.maskTo 64 |> BigInt.toString
        --> "18446744073709551615"

-}
maskTo : Int -> BigInt -> BigInt
maskTo width value =
    if width <= 0 then
        zero

    else
        value
            |> divModBy (powerOfTwo width)
            |> Maybe.map .modulus
            |> Maybe.withDefault zero


{-| The low `width` bits read as two's complement, which is what reading a
value as a signed integer of that width means.

    BigInt.fromString "0xFFFFFFFFFFFFFFFF"
        |> Maybe.map (BigInt.toSigned 64)
        --> Just (BigInt.fromInt -1)

-}
toSigned : Int -> BigInt -> BigInt
toSigned width value =
    if width <= 0 then
        zero

    else
        let
            masked =
                maskTo width value
        in
        if compare masked (powerOfTwo (width - 1)) == LT then
            masked

        else
            masked |> subBy (powerOfTwo width)


{-| Would this survive being stored in a signed integer of this width? That
is, is it within `-2^(width-1)` to `2^(width-1) - 1`?
-}
fitsSigned : Int -> BigInt -> Bool
fitsSigned width value =
    if width <= 0 then
        isZero value

    else if isNegative value then
        compare (abs value) (powerOfTwo (width - 1)) /= GT

    else
        compare value (powerOfTwo (width - 1)) == LT


{-| Would this survive being stored in an unsigned integer of this width?
-}
fitsUnsigned : Int -> BigInt -> Bool
fitsUnsigned width value =
    if width <= 0 then
        isZero value

    else
        not (isNegative value) && bitLength value <= width


powerOfTwo : Int -> BigInt
powerOfTwo exponent =
    shiftLeftBy exponent one


-- READING


{-| Read a number written the way it would be in source: an optional sign, then
`0x`, `0b` or `0o` and its digits, or plain decimal.

The sign may be `+` as well as `-`, so a number that arrives written `+5`
reads as five rather than as nothing. It comes before the prefix, and there
is at most one of it: `+0xff` is 255, and `++5` and `+ 5` are both `Nothing`.

An underscore between two digits is ignored, so `0xdead_beef` and
`1_000_000` both parse, and so does `1__000`. An underscore anywhere else is
not a separator, so `_1`, `1_` and `0x_ff` are `Nothing`.

    BigInt.fromString "0b1010" --> Just (BigInt.fromInt 10)

    BigInt.fromString "-0xff" --> Just (BigInt.fromInt -255)

    BigInt.fromString "+5" --> Just (BigInt.fromInt 5)

    BigInt.fromString "12 apples" --> Nothing

-}
fromString : String -> Maybe BigInt
fromString text =
    let
        parse negative body =
            if String.startsWith "0x" body || String.startsWith "0X" body then
                digits 16 negative (String.dropFirst 2 body)

            else if String.startsWith "0b" body || String.startsWith "0B" body then
                digits 2 negative (String.dropFirst 2 body)

            else if String.startsWith "0o" body || String.startsWith "0O" body then
                digits 8 negative (String.dropFirst 2 body)

            else
                digits 10 negative body
    in
    withSign parse text


{-| Why [`fromStringWithin`](#fromStringWithin) refused.

`NotANumber` is everything the plain [`fromString`](#fromString) returns
`Nothing` for. `TooLong` is a well-formed number that needs more digits than
the limit allows, and it says how many.

-}
type Error
    = NotANumber
    | TooLong { digits : Int, limit : Int }


{-| [`fromString`](#fromString) with a ceiling on how many digits the number
may have, for text that comes from somewhere you do not control:
`fromStringWithin limit text`.

The plain `fromString` does what it is told. A string of a million digits is
a million-digit number, and parsing it costs time that grows with the square
of its length. When the text is untrusted, say how big a number you are
prepared to accept, and anything longer is refused before any arithmetic
starts:

    BigInt.fromStringWithin 20 "18446744073709551615"
        |> Result.map BigInt.toString
    --> Ok "18446744073709551615"

    BigInt.fromStringWithin 20 "123456789012345678901"
    --> Err (BigInt.TooLong { digits = 21, limit = 20 })

    BigInt.fromStringWithin 20 "twelve"
    --> Err BigInt.NotANumber

The digits are counted in the base the text is written in, after the sign,
the prefix, any separators and any leading zeroes, so `0x0000ff` is two
digits. Zero is one digit. A limit below one refuses everything. Malformed
text is `NotANumber` whatever its length.

-}
fromStringWithin : Int -> String -> Result Error BigInt
fromStringWithin limit text =
    let
        parse negative body =
            if String.startsWith "0x" body || String.startsWith "0X" body then
                scanDigits 16 negative (String.dropFirst 2 body)

            else if String.startsWith "0b" body || String.startsWith "0B" body then
                scanDigits 2 negative (String.dropFirst 2 body)

            else if String.startsWith "0o" body || String.startsWith "0O" body then
                scanDigits 8 negative (String.dropFirst 2 body)

            else
                scanDigits 10 negative body
    in
    withSign parse text
        |> Result.fromMaybe NotANumber
        |> Result.andThen (buildWithin limit)


{-| [`fromStringWithBase`](#fromStringWithBase) with the same ceiling as
[`fromStringWithin`](#fromStringWithin): `fromStringWithBaseWithin base limit
text`. The digits are counted in `base`, so the same limit admits a longer
number in hexadecimal than in binary.

    BigInt.fromStringWithBaseWithin 16 4 "dead"
        |> Result.map BigInt.toString
    --> Ok "57005"

    BigInt.fromStringWithBaseWithin 2 4 "11111"
    --> Err (BigInt.TooLong { digits = 5, limit = 4 })

A base outside 2 to 36 is `NotANumber`, as it is `Nothing` for the plain
function.

-}
fromStringWithBaseWithin : Int -> Int -> String -> Result Error BigInt
fromStringWithBaseWithin base limit text =
    withSign (\negative body -> scanDigits base negative body) text
        |> Result.fromMaybe NotANumber
        |> Result.andThen (buildWithin limit)


{-| The second half of a bounded read: count the digits of a scanned body,
and either refuse or do the arithmetic.
-}
buildWithin : Int -> Scanned -> Result Error BigInt
buildWithin limit scanned =
    let
        count =
            Basics.max 1 (String.count (trimLeadingZeroes scanned.body))
    in
    if count > limit then
        Err (TooLong { digits = count, limit = limit })

    else
        Ok (buildDigits scanned)


trimLeadingZeroes : String -> String
trimLeadingZeroes body =
    if String.startsWith "0" body then
        trimLeadingZeroes (String.dropFirst 1 body)

    else
        body


{-| Read a number in a base from 2 to 36, with an optional sign and no prefix.
Underscores between digits are ignored here too.
-}
fromStringWithBase : Int -> String -> Maybe BigInt
fromStringWithBase base text =
    withSign (\negative body -> digits base negative body) text


withSign : (Bool -> String -> a) -> String -> a
withSign parse text =
    if String.startsWith "-" text then
        parse True (String.dropFirst 1 text)

    else if String.startsWith "+" text then
        parse False (String.dropFirst 1 text)

    else
        parse False text


digits : Int -> Bool -> String -> Maybe BigInt
digits base negative rawBody =
    scanDigits base negative rawBody
        |> Maybe.map buildDigits


{-| What a scan of the text leaves: a validated body of digits in the base,
separators removed, and the sign. No arithmetic has happened yet, so
producing one of these costs time linear in the text.
-}
type alias Scanned =
    { base : Int, negative : Bool, body : String }


scanDigits : Int -> Bool -> String -> Maybe Scanned
scanDigits base negative rawBody =
    let
        body =
            dropSeparators rawBody

        isDigitOfBase char =
            when digitValue char is
                Just digit ->
                    digit < base

                Nothing ->
                    False
    in
    if base < 2 || base > 36 || String.isEmpty body || not (String.all isDigitOfBase body) then
        Nothing

    else
        Just { base = base, negative = negative, body = body }


{-| The arithmetic: one multiply-and-add per digit, which is quadratic in the
length of the body because the running total grows with every step.
-}
buildDigits : Scanned -> BigInt
buildDigits scanned =
    let
        radix =
            fromInt scanned.base

        step char total =
            add (mul total radix) (fromInt (Maybe.withDefault 0 (digitValue char)))

        magnitude =
            String.foldl step zero scanned.body
    in
    if scanned.negative then
        negate magnitude

    else
        magnitude


{-| Remove the underscores that sit between two digits, and only those. An
underscore anywhere else, including a run of them that touches a sign, a
prefix or an end of the text, is left in place, and the digit parser rejects
it.

A run of underscores between two digits counts as one separator, so
`1__000` reads the same as `1_000`.

-}
dropSeparators : String -> String
dropSeparators text =
    if not (String.contains "_" text) then
        text

    else
        dropSeparatorsFrom text


dropSeparatorsFrom : String -> String
dropSeparatorsFrom text =
    let
        isDigit char =
            digitValue char /= Nothing

        step char state =
            if char == '_' then
                { state | pending = state.pending + 1 }

            else
                let
                    kept =
                        if state.pending > 0 && state.afterDigit && isDigit char then
                            ""

                        else
                            String.repeat state.pending "_"
                in
                { pending = 0
                , afterDigit = isDigit char
                , out = state.out ++ kept ++ String.fromChar char
                }

        final =
            String.foldl step { pending = 0, afterDigit = False, out = "" } text
    in
    final.out ++ String.repeat final.pending "_"


digitValue : Char -> Maybe Int
digitValue char =
    let
        code =
            Char.toCode char
    in
    if code >= 0x30 && code <= 0x39 then
        Just (code - 0x30)

    else if code >= 0x61 && code <= 0x7A then
        Just (code - 0x61 + 10)

    else if code >= 0x41 && code <= 0x5A then
        Just (code - 0x41 + 10)

    else
        Nothing


-- WRITING


{-| Decimal, with a leading `-` when negative.
-}
toString : BigInt -> String
toString value =
    toStringWithBase 10 value


{-| In a base from 2 to 36, with digits `0`-`9` then `a`-`z`, and a leading `-`
when negative. No prefix: `toStringWithBase 16` gives `"ff"`, not `"0xff"`.

A negative number is written with a sign rather than as two's complement, so
`toStringWithBase 16 (fromInt -255)` is `"-ff"`. If you want the bit pattern
a machine would show for a 64-bit value, apply [`maskTo`](#maskTo) first; that
is what it is for.

Anything outside 2 to 36 gives `""`.

-}
toStringWithBase : Int -> BigInt -> String
toStringWithBase base value =
    if base < 2 || base > 36 then
        ""

    else if isZero value then
        "0"

    else
        let
            body =
                when digitsPerLimb base is
                    Just width ->
                        sliceLimbs base width (unwrap (abs value))

                    Nothing ->
                        let
                            -- The largest power of the base that still fits in
                            -- one limb, so the number is consumed a chunk at a
                            -- time rather than a digit at a time.
                            chunk =
                                largestPower base 1 0
                        in
                        chunks chunk.value chunk.digits base (unwrap (abs value)) []
        in
        if isNegative value then
            "-" ++ body

        else
            body


{-| How many digits of this base one limb is worth, when it is a whole number
of them.

Only the bases whose bit width divides 24: two, four, eight and sixteen. That
divisibility is the property the limb size was chosen for, and this is the
function that uses it. Base 32 is a power of two and still does not qualify,
because a digit is five bits and 24 is not divisible by five.

-}
digitsPerLimb : Int -> Maybe Int
digitsPerLimb base =
    when base is
        2 ->
            Just limbBits

        4 ->
            Just (limbBits // 2)

        8 ->
            Just (limbBits // 3)

        16 ->
            Just (limbBits // 4)

        _ ->
            Nothing


{-| Write a magnitude in a base whose digits divide a limb evenly: each limb
becomes a fixed run of digits, and the answer is those runs concatenated with
the most significant limb first. No division, no carries, and nothing that
depends on the size of the number: the digits of a limb are already digits of
the answer, in the right place.

The top limb is written at whatever width it needs, so the result has no
leading zeroes. Every limb below it is padded to the full width, because a zero
*inside* a number is a digit of it. The padding is what makes this correct:
without it `2^48 + 1` would print as `11`.

-}
sliceLimbs : Int -> Int -> Array Int -> String
sliceLimbs base width limbs =
    when Array.popLast limbs is
        Just popped ->
            String.join ""
                (Array.pushFirst (limbToString base popped.last)
                    (Array.reverse
                        (Array.map
                            (\limb -> String.padLeft width '0' (limbToString base limb))
                            popped.initial
                        )
                    )
                )

        Nothing ->
            -- Unreachable: zero is answered before this is reached.
            "0"


largestPower : Int -> Int -> Int -> { value : Int, digits : Int }
largestPower base value count =
    if value * base >= limbBase then
        { value = value, digits = count }

    else
        largestPower base (value * base) (count + 1)


chunks : Int -> Int -> Int -> Array Int -> Array String -> String
chunks divisor width base limbs acc =
    let
        answer =
            magDivModLimb divisor limbs

        text =
            limbToString base answer.remainder
    in
    if Array.isEmpty answer.quotient then
        String.join "" (Array.pushFirst text acc)

    else
        chunks divisor
            width
            base
            answer.quotient
            (Array.pushFirst (String.padLeft width '0' text) acc)


limbToString : Int -> Int -> String
limbToString base value =
    if value < base then
        digitChar value

    else
        limbToString base (value // base) ++ digitChar (Math.modBy base value)


digitChar : Int -> String
digitChar value =
    String.slice value (value + 1) "0123456789abcdefghijklmnopqrstuvwxyz"
